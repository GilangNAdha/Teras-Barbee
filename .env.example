# Supabase project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only. Needed only by the protected booking route; never prefix this with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for rate-limit hashing and retry-safe booking management links.
# Generate with: openssl rand -hex 32. Keep stable across deployments; changing
# it prevents an outstanding lost-response request from being retried safely.
BOOKING_HASH_SECRET=replace-with-a-long-random-secret

# Optional defaults. Set actual shop contact data in shop_settings in Supabase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
