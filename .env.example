# ---------------------------------------------------------------------------
# Terasbarber environment template. Copy to .env.local and fill in real values.
# Never commit real credentials. Variables prefixed NEXT_PUBLIC_ are exposed to
# the browser; everything below the separator line is server-only.
# ---------------------------------------------------------------------------

# Supabase project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Current Supabase convention: a publishable key (sb_publishable_...).
# Legacy JWT anon keys still work via NEXT_PUBLIC_SUPABASE_ANON_KEY (keep one).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key

# Public site base URL (Auth redirects and absolute links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Business timezone used as fallback; shop_settings.timezone takes precedence.
BOOKING_TIMEZONE=Asia/Jakarta

# Which delivery channels the notification worker is allowed to use.
BOOKING_NOTIFICATION_CHANNELS=telegram,whatsapp

# ---------------------------------------------------------------------------
# Server-only secrets — never prefix these with NEXT_PUBLIC_ or import them
# into a Client Component.
# ---------------------------------------------------------------------------

# Current Supabase convention: secret key (sb_secret_...). Legacy service-role
# JWT keys remain supported via SUPABASE_SERVICE_ROLE_KEY (keep one).
SUPABASE_SECRET_KEY=your-secret-key
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key

# Supabase access token used by the CLI for db push / type generation in CI.
# Not used by the running application. Create one at supabase.com/dashboard/account/tokens.
SUPABASE_ACCESS_TOKEN=your-cli-access-token

# HMAC secret for booking rate-limit hashing. Generate with: openssl rand -hex 32
BOOKING_HASH_SECRET=replace-with-a-long-random-secret

# Shared secret protecting /api/cron/* routes. Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-secret

# Telegram Bot API (create the bot with @BotFather). Leave blank to disable Telegram.
TELEGRAM_BOT_TOKEN=

# WhatsApp Business Cloud API (Meta developer app). Leave blank to disable
# WhatsApp delivery; the app keeps working with Telegram alone and reports
# WhatsApp jobs as unconfigured instead of failing bookings.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
